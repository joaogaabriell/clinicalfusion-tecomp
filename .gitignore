# =========================================================================
#  ClinicalFusion — .gitignore
# =========================================================================

# -------------------------------------------------------------------------
#  DADOS CREDENCIADOS (Symile-MIMIC / MIMIC-IV / PhysioNet)
#  ATENCAO: os dados reais do PhysioNet sao de acesso credenciado e a DUA
#  PROIBE redistribuicao. NUNCA versionar estes arquivos no GitHub.
# -------------------------------------------------------------------------
data/symile-mimic/
data/symile-mimic-aug/
data/symile_mimic/
data/real/
*.dcm
*.hea
*.dat
data_npy/
*.ckpt

# Rede de seguranca: o dataset baixado nao deve ficar dentro do repositorio
# (o lugar dele e FORA da pasta do projeto — ver SETUP.md). Se alguem colocar
# aqui mesmo assim, estas regras evitam que vire commit por um `git add -A`.
physionet.org/
physionet.org*.zip
symile-mimic*.zip
*.npy

# Amostra sintetica gerada em massa (mantemos apenas alguns exemplos versionados
# em data/sample_patients/. O restante gerado localmente fica ignorado.)
data/generated/

# Subconjunto de demonstracao (src/demo_subset.py). Casos ficticios, entao a DUA
# nao se aplica -- fica fora do Git so por ser gerado: o app o recria sozinho no
# primeiro uso, e versiona-lo poria ~17 MB de CSV no repositorio.
data/demo/

# Resultados do benchmark de LLMs (respostas brutas, CSV e relatorio gerados
# localmente; podem conter texto de saida dos modelos).
benchmark_resultados/

# PDFs arquivados localmente pelo n8n quando nenhuma pasta sincronizada externa
# foi escolhida.
relatorios/

# -------------------------------------------------------------------------
#  Python
# -------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ambientes virtuais
.venv/
.venv-*/
venv/
env/
ENV/

# -------------------------------------------------------------------------
#  Streamlit / segredos
# -------------------------------------------------------------------------
.streamlit/secrets.toml
.env
*.key
secrets/

# -------------------------------------------------------------------------
#  Editores / SO
# -------------------------------------------------------------------------
# `.vscode/*` (e nao `.vscode/`) para que o git entre na pasta: uma negacao nao
# reinclui arquivo cujo diretorio pai foi excluido.
.vscode/*
# Excecao: o interpretador aponta para .venv por caminho relativo, entao esta
# configuracao vale para toda a equipe e e versionada de proposito.
!.vscode/settings.json
.idea/
*.swp
.DS_Store
Thumbs.db

# -------------------------------------------------------------------------
#  Obsidian
#  O repositorio e symlinkado dentro de um cofre, e o plugin Zoottelkeeper
#  gera estes indices dentro das pastas. Nao fazem parte do projeto.
# -------------------------------------------------------------------------
HUB *.md
